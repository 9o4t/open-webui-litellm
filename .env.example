# Local compose only. On Railway secrets are generated.
# Provider keys are BYO and optional — the stack boots without them.

# Required locally. Generate: openssl rand -hex 32
# Prefix the LiteLLM master key with sk- (LiteLLM admin UI expects that shape).
WEBUI_SECRET_KEY=
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=change-me

# Optional BYO. Leave blank to boot an empty model list and add keys in LiteLLM later.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
